                                                                    <a href="javascript:void(0)"
                                                                       class="anexo-nota-link"
                                                                       title="Baixar a nota anexada no PlaneIT"
                                                                       onclick="ControleHorasVooAnexo.baixar('{!JSENCODE(ab.Id)}', this);"><svg class="anexo-nota-icone" viewBox="0 0 520 520" aria-hidden="true" focusable="false"><path d="M176 367c6 6 15 5 21 0l100-100a20 20 0 0 1 28 0c9 8 8 22 0 30L202 418a70 70 0 0 1-99 0l-1-1a70 70 0 0 1 0-99l217-217a70 70 0 0 1 99 0l1 1a70 70 0 0 1 0 99l-1 1c-5 5-6 12-2 18a150 150 0 0 1 14 35c2 8 11 10 17 5l15-16a131 131 0 0 0 0-185h-2a131 131 0 0 0-185 0L58 275a131 131 0 0 0 0 185l2 2a130 130 0 0 0 184 0l124-123a81 81 0 1 0-117-113l-98 98c-6 6-6 16 0 22z"/></svg></a>
                                                                </apex:outputPanel>
                                                                <apex:outputText value="{!IF(ab.Documento_Referencia__c != null, ab.Documento_Referencia__c, '-- Não informado --')}"
                                                                                 styleClass="form-control readonly-field"
                                                                                 style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 70px;"/>
                                                            </div>
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Observações de Abastecimento</label>
                                                                <apex:outputText value="{!IF(ab.Observacoes__c != null, ab.Observacoes__c, '-- Não informado --')}"
                                                                                 styleClass="form-control readonly-field"
                                                                                 style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 70px;"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </apex:repeat>
                                            </apex:outputPanel>

                                            <!-- MODO NOVO REGISTRO ou PÓS-SAVE: único abastecimento -->
                                            <apex:outputPanel rendered="{!!modoEdicao}" layout="block" styleClass="fuel-calculation-row">
                                                <div class="form-row">
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Quantidade (L)</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Quantidade__c}" 
                                                                         styleClass="form-control fuel-quantity-field"
                                                                         id="abQtd"
                                                                         html-placeholder="Ex: 100"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!abastecimentoAtual.Quantidade__c}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Custo Unitário (R$/L)</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Custo_Unitario__c}" 
                                                                         styleClass="form-control fuel-unit-cost-field"
                                                                         id="abCustoUnit"
                                                                         html-placeholder="Ex: 10,00 ou 10.00"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!abastecimentoAtual.Custo_Unitario__c}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Custo Total (R$)</label>
                                                        <apex:inputText value="{!abastecimentoAtual.Custo_Total__c}" 
                                                                        styleClass="form-control readonly-field fuel-total-cost-field"
                                                                        id="abCustoTotal"
                                                                        html-readonly="true"
                                                                        rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!abastecimentoAtual.Custo_Total__c}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Média (L/h)</label>
                                                        <apex:inputText styleClass="form-control readonly-field fuel-average-field"
                                                                        id="abMedia"
                                                                        html-readonly="true"
                                                                        rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="-- calculado --" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Tipo Combustível</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Tipo_Combustivel__c}" 
                                                                         styleClass="form-control"
                                                                         id="abTipoCombustivel"
                                                                         html-placeholder="Ex: AVGAS, JET A, JET A-1, SAF"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <small class="form-hint" style="color:#6c757d; font-size:0.8em;" rendered="{!AND(camposHabilitados, !registroSalvo)}">Exemplo: AVGAS, JET A, JET A-1, SAF</small>
                                                        <apex:outputText value="{!IF(abastecimentoAtual.Tipo_Combustivel__c != null, abastecimentoAtual.Tipo_Combustivel__c, '-- Não informado --')}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Local</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Local__c}" 
                                                                         styleClass="form-control"
                                                                         id="abLocal"
                                                                         html-placeholder="Ex: SNAX"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!IF(abastecimentoAtual.Local__c != null, abastecimentoAtual.Local__c, '-- Não informado --')}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Origem/Destino</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Origem_Destino__c}" 
                                                                         styleClass="form-select"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!IF(abastecimentoAtual.Origem_Destino__c != null, abastecimentoAtual.Origem_Destino__c, '-- Não informado --')}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Documento de Referência</label>
                                                        <apex:outputPanel rendered="{!NOT(ISBLANK(abastecimentoAtual.Caminho_Anexo__c))}" layout="none">
                                                            <a href="javascript:void(0)"
                                                               class="anexo-nota-link"
                                                               title="Baixar a nota anexada no PlaneIT"
                                                               onclick="ControleHorasVooAnexo.baixar('{!JSENCODE(abastecimentoAtual.Id)}', this);"><svg class="anexo-nota-icone" viewBox="0 0 520 520" aria-hidden="true" focusable="false"><path d="M176 367c6 6 15 5 21 0l100-100a20 20 0 0 1 28 0c9 8 8 22 0 30L202 418a70 70 0 0 1-99 0l-1-1a70 70 0 0 1 0-99l217-217a70 70 0 0 1 99 0l1 1a70 70 0 0 1 0 99l-1 1c-5 5-6 12-2 18a150 150 0 0 1 14 35c2 8 11 10 17 5l15-16a131 131 0 0 0 0-185h-2a131 131 0 0 0-185 0L58 275a131 131 0 0 0 0 185l2 2a130 130 0 0 0 184 0l124-123a81 81 0 1 0-117-113l-98 98c-6 6-6 16 0 22z"/></svg></a>
                                                        </apex:outputPanel>
                                                        <apex:inputTextarea value="{!abastecimentoAtual.Documento_Referencia__c}" 
                                                                            styleClass="form-control"
                                                                            style="resize: vertical; min-height: 70px;"
                                                                            html-placeholder="Ex: NF 12345"
                                                                            rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!IF(abastecimentoAtual.Documento_Referencia__c != null, abastecimentoAtual.Documento_Referencia__c, '-- Não informado --')}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 70px;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                    <div class="form-group half-width">
                                                        <label class="form-label">Observações de Abastecimento</label>
                                                        <apex:inputField value="{!abastecimentoAtual.Observacoes__c}" 
                                                                         styleClass="form-control"
                                                                         style="resize: vertical; min-height: 70px;"
                                                                         html-placeholder="Campo opcional — preencha apenas se necessário"
                                                                         rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                        <apex:outputText value="{!IF(abastecimentoAtual.Observacoes__c != null, abastecimentoAtual.Observacoes__c, '-- Não informado --')}" 
                                                                         styleClass="form-control readonly-field"
                                                                         style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 70px;"
                                                                         rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    </div>
                                                </div>
                                            </apex:outputPanel>

                                        </div>
                                    </div>
                                    
                                    <!-- Ações Gerais -->
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="form-actions">
                                                <apex:commandButton action="{!salvarControleHoras}" 
                                                                    value="{!IF(modoEdicao, 'Atualizar Controle', 'Salvar Controle de Horas')}" 
                                                                    styleClass="btn btn-success" 
                                                                    rendered="{!AND(camposHabilitados, !registroSalvo)}"
                                                                    status="loadingStatus"
                                                                    onclick="ControleHorasVoo.executarCalculos();"
                                                                    reRender="workspacePanel,pageMessagesPanel"
                                                                    oncomplete="onTabChange();"/>
                                                <apex:commandButton action="{!limparFormulario}" 
                                                                    value="Novo Controle" 
                                                                    styleClass="btn btn-primary" 
                                                                    immediate="true"
                                                                    rendered="{!registroSalvo}"/>
                                                <apex:commandButton action="{!cancelarNovoControle}" 
                                                                    value="✕ Cancelar" 
                                                                    styleClass="btn btn-outline-primary" 
                                                                    immediate="true"
                                                                    rendered="{!AND(camposHabilitados, !registroSalvo)}"
                                                                    status="loadingStatus"
                                                                    reRender="workspacePanel,pageMessagesPanel"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div> <!-- Fim da aba Novo Voo -->
                                
                                <!-- === ABA: CONTROLE TÉCNICO (antes: Controle de Manutenção) === -->
                                <div id="panelManutencao"
                                     class="tab-pane {!IF(abaAtiva == 'manutencao', 'active', '')}"
                                     role="tabpanel"
                                     aria-label="Controle técnico"
                                     aria-hidden="{!IF(abaAtiva == 'manutencao', 'false', 'true')}">
                                    
                                    <!-- Introdução -->
                                    <div class="new-control-intro">
                                        <h3>Controle Técnico da Aeronave</h3>
                                        <p>Gerencie os dados de manutenção da aeronave. Sempre que houver uma nova manutenção, será criado um novo registro ativo.</p>
                                    </div>
                                    
                                    <!-- Seleção da Aeronave para Manutenção -->
                                    <div class="card">
                                        <div class="card-header">
                                            Seleção da Aeronave
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group">
                                                <label class="form-label required">Aeronave</label>
                                                <apex:selectList value="{!aeronaveIdManutencao}" size="1" styleClass="form-select">
                                                    <apex:selectOptions value="{!aeronaveOptions}"/>
                                                    <apex:actionSupport event="onchange" action="{!selecionarAeronaveManutencao}" reRender="workspacePanel,pageMessagesPanel" status="loadingStatus" oncomplete="setTimeout(calcularHorasRestantesInspecoes, 500);"/>
                                                </apex:selectList>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- === CONTROLE DE MANUTENÇÃO ATIVO === -->
                                    <apex:outputPanel rendered="{!camposManutencaoHabilitados}">
                                        
                                        <!-- CASO NÃO TENHA INSPEÇÕES -->
                                        <apex:outputPanel rendered="{!NOT(temInspecoes)}">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h4>Inspeções da Aeronave</h4>
                                                </div>
                                                <div class="card-body">
                                                    <div class="empty-state" style="text-align: center; padding: 40px 20px;">
                                                        <h3 style="color: #495057; margin-bottom: 10px;">Nenhuma inspeção encontrada</h3>
                                                        <p style="color: #6c757d; margin-bottom: 30px;">
                                                            Sincronize os dados de inspeções da aeronave <strong>{!aeronaveManutencao.Name}</strong> a partir da API Planeit.
                                                        </p>
                                                        <apex:commandButton action="{!sincronizarControleTecnicoAeronave}" 
                                                                            value="🔄 Sincronizar Inspeções do Planeit" 
                                                                            styleClass="btn btn-primary" 
                                                                            style="font-size: 16px; padding: 12px 30px;"
                                                                            status="loadingStatus"
                                                                            reRender="workspacePanel,pageMessagesPanel"
                                                                            oncomplete="setTimeout(calcularHorasRestantesInspecoes, 500);"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </apex:outputPanel>
                                        
                                        <!-- CASO TENHA INSPEÇÕES -->
                                        <apex:outputPanel rendered="{!temInspecoes}">
                                            <div class="card">
                                                <div class="card-header">
                                                    <h4>Inspeções da Aeronave - {!aeronaveManutencao.Name}</h4>
                                                </div>
                                                <div class="card-body">
                                                    
                                                    <div class="alert alert-info" style="background: #e3f2fd; border: 1px solid #2196f3; border-radius: 6px; padding: 12px; margin-bottom: 20px; font-size: 13px;">
                                                        <strong>ℹ️ Informação:</strong> Dados sincronizados automaticamente da API Planeit.
                                                        Use o botão abaixo para atualizar as informações.
                                                    </div>
                                                    
                                                    <!-- Horas Totais da Aeronave -->
                                                    <div class="row" style="margin-bottom: 20px;">
                                                        <div class="col">
                                                            <div class="form-group">
                                                                <label class="form-label">Horas Totais da Aeronave:</label>
                                                                <div class="readonly-display" style="font-size: 18px; font-weight: bold; color: var(--cor-primaria);">
                                                                    <apex:outputText value="{0, number, #####0.00}">
                                                                        <apex:param value="{!aeronaveManutencao.Horas_Totais_de_Voo__c}"/>
                                                                    </apex:outputText> h
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- Grid de Inspeções Dinâmico -->
                                                    <div class="controle-tecnico-grid" id="inspecoesGrid" data-horas-totais="{!aeronaveManutencao.Horas_Totais_de_Voo__c}">
                                                        <apex:repeat value="{!inspecoesAeronave}" var="inspecao">
                                                            <div class="intervalo-card inspecao-card status-{!inspecao.nivelStatus} {!IF(inspecao.status == 'VENCIDA', 'card-vencida', '')}"
                                                                 data-horas-restantes="{!inspecao.horasRestantes}"
                                                                 data-dias-restantes="{!inspecao.diasRestantes}"
                                                                 data-status="{!inspecao.status}">
                                                                <div class="intervalo-card-header">
                                                                    Inspeção de {!inspecao.registro.Nome_Inspecao__c}
                                                                </div>
                                                                
                                                                <!-- Próxima Inspeção (por horas) -->
                                                                <apex:outputPanel rendered="{!inspecao.registro.Horas_Proxima__c != null}">
                                                                    <div class="{!IF(inspecao.status == 'VENCIDA', 'intervalo-proxima-vencida', 'intervalo-proxima')}">
                                                                        <div class="intervalo-proxima-label">Próxima Inspeção</div>
                                                                        <div class="intervalo-proxima-valor">
                                                                            <apex:outputText value="{0, number, #####0.00}">
                                                                                <apex:param value="{!inspecao.registro.Horas_Proxima__c}"/>
                                                                            </apex:outputText> h
                                                                        </div>
                                                                    </div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Próxima Inspeção (por data - ex: CVA) -->
                                                                <apex:outputPanel rendered="{!AND(inspecao.registro.Horas_Proxima__c == null, inspecao.registro.Data_Proxima__c != null)}">
                                                                    <div class="{!IF(inspecao.status == 'VENCIDA', 'intervalo-proxima-vencida', 'intervalo-proxima')}">
                                                                        <div class="intervalo-proxima-label">Próxima Inspeção</div>
                                                                        <div class="intervalo-proxima-valor">
                                                                            <apex:outputText value="{0, date, dd/MM/yyyy}">
                                                                                <apex:param value="{!inspecao.registro.Data_Proxima__c}"/>
                                                                            </apex:outputText>
                                                                        </div>
                                                                    </div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Quando não tem horas nem data próxima -->
                                                                <apex:outputPanel rendered="{!AND(inspecao.registro.Horas_Proxima__c == null, inspecao.registro.Data_Proxima__c == null)}">
                                                                    <!-- Caso TBO VENCIDA (Status = VENCIDA e sem dados) -->
                                                                    <apex:outputPanel rendered="{!inspecao.status == 'VENCIDA'}">
                                                                        <div class="intervalo-proxima-vencida" style="background: #dc3545; color: white; text-align: center; padding: 12px;">
                                                                            <div style="font-size: 20px; font-weight: bold;">⚠️ VENCIDA</div>
                                                                            <div style="font-size: 11px; margin-top: 4px; opacity: 0.9;">
                                                                                Inspeção não realizada ou informações pendentes
                                                                            </div>
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <!-- Outros casos sem dados -->
                                                                    <apex:outputPanel rendered="{!inspecao.status != 'VENCIDA'}">
                                                                        <div class="intervalo-proxima-vencida">
                                                                            <div class="intervalo-proxima-label">Última Execução</div>
                                                                            <div class="intervalo-proxima-valor">
                                                                                <apex:outputPanel rendered="{!inspecao.registro.Horas_Execucao__c != null}">
                                                                                    <apex:outputText value="{0, number, #####0.00}">
                                                                                        <apex:param value="{!inspecao.registro.Horas_Execucao__c}"/>
                                                                                    </apex:outputText> h
                                                                                </apex:outputPanel>
                                                                                <apex:outputPanel rendered="{!inspecao.registro.Horas_Execucao__c == null}">
                                                                                    Sem registro
                                                                                </apex:outputPanel>
                                                                            </div>
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Horas restantes calculadas no servidor -->
                                                                <apex:outputPanel rendered="{!inspecao.registro.Horas_Proxima__c != null}">
                                                                    <div class="horas-restantes-container" style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e9ecef; text-align: center;">
                                                                        <div style="font-size: 11px; color: #6c757d; text-transform: uppercase;">Horas Restantes</div>
                                                                        <div class="horas-restantes-valor" style="font-size: 16px; font-weight: bold;">
                                                                            <apex:outputText value="{0, number, #,##0.0}">
                                                                                <apex:param value="{!inspecao.horasRestantes}"/>
                                                                            </apex:outputText> h
                                                                        </div>
                                                                    </div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Dias restantes calculados no servidor -->
                                                                <apex:outputPanel rendered="{!AND(inspecao.registro.Horas_Proxima__c == null, inspecao.registro.Data_Proxima__c != null)}">
                                                                    <div class="dias-restantes-container" style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e9ecef; text-align: center;">
                                                                        <div style="font-size: 11px; color: #6c757d; text-transform: uppercase;">Tempo Restante</div>
                                                                        <div class="dias-restantes-valor" style="font-size: 16px; font-weight: bold;">
                                                                            {!inspecao.diasRestantes} dias
                                                                        </div>
                                                                    </div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Última Execução -->
                                                                <apex:outputPanel rendered="{!inspecao.registro.Horas_Execucao__c != null}">
                                                                    <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e9ecef; font-size: 11px; color: #6c757d;">
                                                                        <strong>Última:</strong> 
                                                                        <apex:outputText value="{0, number, #####0.00}">
                                                                            <apex:param value="{!inspecao.registro.Horas_Execucao__c}"/>
                                                                        </apex:outputText> h
                                                                        <apex:outputPanel rendered="{!inspecao.registro.Data_Execucao__c != null}">
                                                                            em <apex:outputText value="{0, date, dd/MM/yyyy}">
                                                                            <apex:param value="{!inspecao.registro.Data_Execucao__c}"/>
                                                                            </apex:outputText>
                                                                        </apex:outputPanel>
                                                                        
                                                                        <!-- Responsável pela Execução -->
                                                                        <div style="margin-top: 4px; font-size: 10px; color: rgba(108, 117, 125, 0.7);">
                                                                            <span style="font-weight: 600;">Resp: </span> 
                                                                            <apex:outputText value="{!IF(ISBLANK(inspecao.registro.Responsavel_Execucao__c), 'Não informado', inspecao.registro.Responsavel_Execucao__c)}"/>
                                                                        </div>
                                                                    </div>
                                                                </apex:outputPanel>
                                                            </div>
                                                        </apex:repeat>
                                                    </div>
                                                    
                                                    <!-- Botão de Sincronização -->
                                                    <div style="text-align: center; margin-top: 20px;">
                                                        <apex:commandButton action="{!sincronizarControleTecnicoAeronave}" 
                                                                            value="🔄 Atualizar Inspeções do Planeit" 
                                                                            styleClass="btn btn-primary" 
                                                                            style="font-size: 14px; padding: 10px 24px;"
                                                                            status="loadingStatus"
                                                                            reRender="workspacePanel,pageMessagesPanel"
                                                                            oncomplete="setTimeout(calcularHorasRestantesInspecoes, 500);"/>
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                        </apex:outputPanel>
                                        
                                    </apex:outputPanel>
                                    
                                    <!-- Estado sem aeronave selecionada -->
                                    <apex:outputPanel rendered="{!!camposManutencaoHabilitados}">
                                        <div class="empty-state">
                                            <h3>Selecione uma aeronave</h3>
                                            <p>Escolha uma aeronave para visualizar e gerenciar o controle de manutenção.</p>
                                        </div>
                                    </apex:outputPanel>
                                    
                                </div> <!-- Fim da aba Controle Técnico -->

                                <!-- === ABA: AERONAVES (Frota Própria/Locada) === -->
                                <div id="panelAeronaves"
                                     class="tab-pane aircraft-tab {!IF(abaAtiva == 'aeronaves', 'active', '')}"
                                     role="tabpanel"
                                     aria-label="Aeronaves"
                                     aria-hidden="{!IF(abaAtiva == 'aeronaves', 'false', 'true')}">

                                    <div class="aircraft-tab-heading">
                                        <div class="aircraft-tab-heading-copy">
                                            <span class="aircraft-eyebrow">Gestão da frota</span>
                                            <h2>Cadastro de aeronaves</h2>
                                            <p>Gerencie aeronaves próprias e locadas. A frota locada não participa da sincronização automática com o Planeit.</p>
                                        </div>
                                        <apex:commandButton value="Nova aeronave"
                                                            action="{!novaAeronave}"
                                                            styleClass="btn btn-primary"
                                                            reRender="pageMessagesPanel,aeronavesPanel"
                                                            status="loadingStatus"/>
                                    </div>

                                    <apex:outputPanel id="aeronavesPanel">

                                        <!-- Filtros -->
                                        <div class="aircraft-panel">
                                            <div class="aircraft-panel-heading">
                                                <div>
                                                    <h3>Filtros</h3>
                                                    <p>Refine a lista por tipo de frota e disponibilidade.</p>
                                                </div>
                                            </div>
                                            <div class="aircraft-panel-body">
                                                <div class="aircraft-filter-grid">
                                                    <div class="aircraft-field">
                                                        <apex:outputLabel value="Tipo de frota" for="filtroTipoFrota" styleClass="form-label"/>
                                                        <apex:selectList id="filtroTipoFrota" value="{!filtroTipoFrotaAeronaves}" size="1" styleClass="form-select">
                                                            <apex:selectOption itemValue="" itemLabel="Todas"/>
                                                            <apex:selectOption itemValue="Propria" itemLabel="Frota própria"/>
                                                            <apex:selectOption itemValue="Locada" itemLabel="Frota locada"/>
                                                        </apex:selectList>
                                                    </div>
                                                    <div class="aircraft-field">
                                                        <apex:outputLabel value="Status" for="filtroStatus" styleClass="form-label"/>
                                                        <apex:selectList id="filtroStatus" value="{!filtroStatusAeronaves}" size="1" styleClass="form-select">
                                                            <apex:selectOption itemValue="" itemLabel="Todos"/>
                                                            <apex:selectOption itemValue="ativas" itemLabel="Somente ativas"/>
                                                            <apex:selectOption itemValue="inativas" itemLabel="Somente inativas"/>
                                                        </apex:selectList>
                                                    </div>
                                                    <div class="aircraft-filter-actions">
                                                        <apex:commandButton value="Aplicar filtros"
                                                                            action="{!aplicarFiltrosAeronaves}"
                                                                            styleClass="btn btn-outline-primary"
                                                                            reRender="pageMessagesPanel,aeronavesPanel"
                                                                            status="loadingStatus"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Formulário de criação/edição -->
                                        <apex:outputPanel rendered="{!modoEdicaoAeronave}"
                                                          layout="block"
                                                          styleClass="aircraft-panel aircraft-form-card aircraft-panel-enter">
                                            <div class="aircraft-panel-heading">
                                                <div>
                                                    <h3>{!tituloFormularioAeronave}</h3>
                                                    <p>Preencha os dados operacionais e a disponibilidade da aeronave.</p>
                                                </div>
                                            </div>
                                            <div class="aircraft-panel-body">
                                                <div class="aircraft-form-section">
                                                    <div class="aircraft-section-heading">
                                                        <h4>Identificação</h4>
                                                        <p>Informações principais para reconhecer a aeronave na operação.</p>
                                                    </div>
                                                    <div class="aircraft-form-grid">
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Matrícula" for="aeronaveMatricula" styleClass="form-label required"/>
                                                            <apex:inputField id="aeronaveMatricula" value="{!aeronaveForm.Name}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Modelo" for="aeronaveModelo" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveModelo" value="{!aeronaveForm.Modelo__c}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Fabricante" for="aeronaveFabricante" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveFabricante" value="{!aeronaveForm.Fabricante__c}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Ano de fabricação" for="aeronaveAno" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveAno" value="{!aeronaveForm.Ano_de_Fabricacao__c}" styleClass="form-control"/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="aircraft-form-section">
                                                    <div class="aircraft-section-heading">
                                                        <h4>Parâmetros operacionais</h4>
                                                        <p>Consumo em litros por hora e velocidades médias utilizadas nos cálculos.</p>
                                                    </div>
                                                    <div class="aircraft-form-grid">
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Consumo (L/h)" for="aeronaveConsumo" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveConsumo" value="{!aeronaveForm.Consumo__c}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Consumo em translado (L/h)" for="aeronaveConsumoTranslado" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveConsumoTranslado" value="{!aeronaveForm.Consumo_translado__c}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Velocidade média" for="aeronaveVelocidade" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveVelocidade" value="{!aeronaveForm.Velocidade_media__c}" styleClass="form-control"/>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Velocidade média em translado" for="aeronaveVelocidadeTranslado" styleClass="form-label"/>
                                                            <apex:inputField id="aeronaveVelocidadeTranslado" value="{!aeronaveForm.Velocidade_media_translado__c}" styleClass="form-control"/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="aircraft-form-section">
                                                    <div class="aircraft-section-heading">
                                                        <h4>Frota e disponibilidade</h4>
                                                        <p>Defina a origem da aeronave e se ela pode ser utilizada em novos apontamentos.</p>
                                                    </div>
                                                    <div class="aircraft-form-grid aircraft-form-grid--fleet">
                                                        <div class="aircraft-field">
                                                            <apex:outputLabel value="Tipo de frota" for="aeronaveTipoFrota" styleClass="form-label required"/>
                                                            <apex:inputField id="aeronaveTipoFrota" value="{!aeronaveForm.Tipo_Frota__c}" styleClass="form-select">
                                                                <apex:actionSupport event="onchange" reRender="empresaLocadoraGroup" status="loadingStatus"/>
                                                            </apex:inputField>
                                                        </div>
                                                        <div class="aircraft-field">
                                                            <span class="form-label">Disponibilidade</span>
                                                            <label class="aircraft-toggle-control">
                                                                <span class="aircraft-toggle">
                                                                    <apex:inputField id="aeronaveAtiva" value="{!aeronaveForm.Ativo__c}"/>
                                                                    <span class="aircraft-toggle-slider"></span>
                                                                </span>
                                                                <span class="aircraft-toggle-copy">
                                                                    <strong>Aeronave ativa</strong>
                                                                    <small>Disponível para novos registros</small>
                                                                </span>
                                                            </label>
                                                        </div>
                                                        <apex:outputPanel id="empresaLocadoraGroup" layout="block" styleClass="aircraft-field">
                                                            <apex:outputPanel rendered="{!aeronaveForm.Tipo_Frota__c == 'Locada'}" layout="block">
                                                                <apex:outputLabel value="Empresa locadora" for="aeronaveEmpresaLocadora" styleClass="form-label"/>
                                                                <apex:inputField id="aeronaveEmpresaLocadora" value="{!aeronaveForm.Empresa_Locadora__c}" styleClass="form-control"/>
                                                            </apex:outputPanel>
                                                        </apex:outputPanel>
                                                    </div>
                                                </div>

                                                <div class="form-actions">
                                                    <apex:commandButton value="Cancelar"
                                                                        action="{!cancelarEdicaoAeronave}"
                                                                        styleClass="btn btn-outline-primary"
                                                                        reRender="pageMessagesPanel,aeronavesPanel"
                                                                        status="loadingStatus"
                                                                        immediate="true"/>
                                                    <apex:commandButton value="Salvar aeronave"
                                                                        action="{!salvarAeronave}"
                                                                        styleClass="btn btn-primary"
                                                                        reRender="pageMessagesPanel,aeronavesPanel"
                                                                        status="loadingStatus"/>
                                                </div>
                                            </div>
                                        </apex:outputPanel>

                                        <!-- Listagem -->
                                        <div class="aircraft-panel aircraft-list-panel">
                                            <div class="aircraft-panel-heading">
                                                <div>
                                                    <h3>Aeronaves</h3>
                                                    <p>Consulte, edite ou altere a disponibilidade da frota.</p>
                                                </div>
                                                <span class="aircraft-count">{!listaAeronaves.size}</span>
                                            </div>
                                            <apex:outputPanel rendered="{!listaAeronaves.size == 0}">
                                                <div class="empty-state">
                                                    <h3>Nenhuma aeronave encontrada</h3>
                                                    <p>Ajuste os filtros ou cadastre uma nova aeronave.</p>
                                                </div>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!listaAeronaves.size > 0}" layout="block" styleClass="aircraft-table-wrap">
                                                <table class="aircraft-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Matrícula</th>
                                                            <th>Modelo</th>
                                                            <th>Fabricante</th>
                                                            <th>Frota</th>
                                                            <th>Status</th>
                                                            <th>Horas totais</th>
                                                            <th>Ações</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <apex:repeat value="{!listaAeronaves}" var="item">
                                                            <tr>
                                                                <td data-label="Matrícula">
                                                                    <span class="aircraft-registration">{!item.Name}</span>
                                                                </td>
                                                                <td data-label="Modelo">{!item.Modelo__c}</td>
                                                                <td data-label="Fabricante">{!item.Fabricante__c}</td>
                                                                <td data-label="Frota">
                                                                    <span class="aircraft-badge">
                                                                        <apex:outputText value="{!IF(item.Tipo_Frota__c == 'Locada', 'Locada', 'Própria')}"/>
                                                                    </span>
                                                                </td>
                                                                <td data-label="Status">
                                                                    <span class="{!IF(item.Ativo__c, 'aircraft-status aircraft-status--active', 'aircraft-status aircraft-status--inactive')}">
                                                                        <apex:outputText value="{!IF(item.Ativo__c, 'Ativa', 'Inativa')}"/>
                                                                    </span>
                                                                </td>
                                                                <td data-label="Horas totais">
                                                                    <apex:outputText value="{0, number, #####0.00}">
                                                                        <apex:param value="{!item.Horas_Totais_de_Voo__c}"/>
                                                                    </apex:outputText>
                                                                </td>
                                                                <td data-label="Ações" class="aircraft-cell-actions">
                                                                    <div class="aircraft-row-actions">
                                                                        <apex:commandButton value="Editar"
                                                                                            action="{!editarAeronave}"
                                                                                            styleClass="btn btn-outline-primary"
                                                                                            reRender="pageMessagesPanel,aeronavesPanel"
                                                                                            status="loadingStatus">
                                                                            <apex:param name="aeronaveId" value="{!item.Id}"/>
                                                                        </apex:commandButton>
                                                                        <apex:commandButton value="{!IF(item.Ativo__c, 'Desativar', 'Ativar')}"
                                                                                            action="{!alternarAtivoAeronave}"
                                                                                            styleClass="{!IF(item.Ativo__c, 'btn aircraft-btn-danger', 'btn aircraft-btn-success')}"
                                                                                            reRender="pageMessagesPanel,aeronavesPanel"
                                                                                            status="loadingStatus">
                                                                            <apex:param name="aeronaveId" value="{!item.Id}"/>
                                                                        </apex:commandButton>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </apex:repeat>
                                                    </tbody>
                                                </table>
                                            </apex:outputPanel>
                                        </div>

                                    </apex:outputPanel>

                                </div> <!-- Fim da aba Aeronaves -->

                            </div> <!-- Fim do tab-content -->
                        </div> <!-- Fim do tabs-container -->

                        <div id="flightReportModal"
                             class="report-modal-overlay"
                             hidden="hidden">
                            <section class="report-modal"
                                     role="dialog"
                                     aria-modal="true"
                                     aria-labelledby="flightReportTitle"
                                     aria-describedby="flightReportDescription"
                                     tabindex="-1">
                                <header class="report-modal-header">
                                    <div>
                                        <span class="report-modal-eyebrow">Relatório operacional</span>
                                        <h2 id="flightReportTitle">Exportar horas de voo</h2>
                                        <p id="flightReportDescription">
                                            Gere um arquivo Excel com resumo por responsável, detalhamento e totais.
                                        </p>
                                    </div>
                                    <button type="button"
                                            class="report-modal-close"
                                            aria-label="Fechar exportação">
                                        ×
                                    </button>
                                </header>

                                <div class="report-modal-body">
                                    <input type="hidden"
                                           class="report-access-token"
                                           value="{!relatorioAccessToken}"/>

                                    <fieldset class="report-fieldset">
                                        <legend>Organizar por</legend>
                                        <div class="report-segmented" role="radiogroup" aria-label="Organizar relatório por">
                                            <button type="button"
                                                    class="report-mode-option is-active"
                                                    data-report-mode="PILOTO"
                                                    role="radio"
                                                    aria-checked="true">
                                                Piloto
                                            </button>
                                            <button type="button"
                                                    class="report-mode-option"
                                                    data-report-mode="OPERADOR"
                                                    role="radio"
                                                    aria-checked="false">
                                                Operador
                                            </button>
                                        </div>
                                    </fieldset>

                                    <div class="report-filter-grid">
                                        <div class="report-field">
                                            <apex:outputLabel value="Aeronave" for="reportAircraft"/>
                                            <apex:selectList id="reportAircraft"
                                                             value="{!relatorioAeronaveId}"
                                                             size="1"
                                                             styleClass="form-select report-aircraft">
                                                <apex:selectOptions value="{!relatorioAeronaveOptions}"/>
                                            </apex:selectList>
                                        </div>
                                        <div class="report-field report-responsible-field report-pilot-field">
                                            <apex:outputLabel value="Piloto" for="reportPilot"/>
                                            <apex:selectList id="reportPilot"
                                                             value="{!relatorioPilotoId}"
                                                             size="1"
                                                             styleClass="form-select report-pilot">
                                                <apex:selectOptions value="{!relatorioPilotoOptions}"/>
                                            </apex:selectList>
                                        </div>
                                        <div class="report-field report-responsible-field report-operator-field"
                                             hidden="hidden">
                                            <apex:outputLabel value="Operador" for="reportOperator"/>
                                            <apex:selectList id="reportOperator"
                                                             value="{!relatorioOperadorId}"
                                                             size="1"
                                                             styleClass="form-select report-operator">
                                                <apex:selectOptions value="{!relatorioOperadorOptions}"/>
                                            </apex:selectList>
                                        </div>
                                        <div class="report-field">
                                            <label for="reportStartDate">Data inicial</label>
                                            <input id="reportStartDate"
                                                   class="form-control report-start-date"
                                                   type="date"/>
                                        </div>
                                        <div class="report-field">
                                            <label for="reportEndDate">Data final</label>
                                            <input id="reportEndDate"
                                                   class="form-control report-end-date"
                                                   type="date"/>
                                        </div>
                                    </div>

                                    <fieldset class="report-fieldset report-flight-types">
                                        <legend>Tipos de voo</legend>
                                        <div class="report-type-grid">
                                            <label class="report-type-control">
                                                <span class="aircraft-toggle">
                                                    <input type="checkbox" value="TR" checked="checked"/>
                                                    <span class="aircraft-toggle-slider"></span>
                                                </span>
                                                <span><strong>TR</strong> Translado</span>
                                            </label>
                                            <label class="report-type-control">
                                                <span class="aircraft-toggle">
                                                    <input type="checkbox" value="SA" checked="checked"/>
                                                    <span class="aircraft-toggle-slider"></span>
                                                </span>
                                                <span><strong>SA</strong> Serviço Aéreo</span>
                                            </label>
                                            <label class="report-type-control">
                                                <span class="aircraft-toggle">
                                                    <input type="checkbox" value="PV" checked="checked"/>
                                                    <span class="aircraft-toggle-slider"></span>
                                                </span>
                                                <span><strong>PV</strong> Privado</span>
                                            </label>
                                            <label class="report-type-control">
                                                <span class="aircraft-toggle">
                                                    <input type="checkbox" value="EX" checked="checked"/>
                                                    <span class="aircraft-toggle-slider"></span>
                                                </span>
                                                <span><strong>EX</strong> Experimental</span>
                                            </label>
                                            <label class="report-type-control">
                                                <span class="aircraft-toggle">
                                                    <input type="checkbox" value="TT" checked="checked"/>
                                                    <span class="aircraft-toggle-slider"></span>
                                                </span>
                                                <span><strong>TT</strong> Tentativa</span>
                                            </label>
                                        </div>
                                    </fieldset>

                                    <div class="report-feedback"
                                         role="status"
                                         aria-live="polite"
                                         hidden="hidden"></div>
                                </div>

                                <footer class="report-modal-footer">
                                    <button type="button"
                                            class="btn btn-outline-primary report-cancel">
                                        Cancelar
                                    </button>
                                    <button type="button"
                                            class="btn btn-primary report-generate">
                                        <span class="report-export-icon" aria-hidden="true">↓</span>
                                        Gerar Excel
                                    </button>
                                </footer>
                            </section>
                        </div>
                        
                        <!-- Status de carregamento -->
                        <apex:actionStatus id="loadingStatus">
                            <apex:facet name="start">
                                <div class="loading-overlay">
                                    <div class="loading-content" style="text-align: center; ">
                                        <div class="loading"></div>
                                        Processando...
                                    </div>
                                </div>
                            </apex:facet>
                        </apex:actionStatus>
                    </div>
                </apex:outputPanel>
            </apex:form>
        </apex:define>
    </apex:composition>
</apex:page>
