<apex:page controller="ControleHorasVooController" showHeader="false" sidebar="false" cache="false" docType="html-5.0">
    <!-- Página de Controle de Horas de Voo - Cálculos realizados no frontend -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <apex:includeScript value="{!URLFOR($Resource.ChartJs, 'chart.min.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.ControleHorasVooAssets, 'controle-horas.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.ControleHorasVooAssets, 'controle-horas-report.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.ControleHorasVooAssets, 'controle-horas.css')}"/>
    
    <apex:composition template="HomePage">
        <apex:define name="content_body">
            <script>
                window.controleHorasVooAccessToken = '{!JSENCODE(relatorioAccessToken)}';
                window.controleHorasVooReportLibraryUrl =
                    '{!JSENCODE($Resource.exceljs)}';
                window.gerarRelatorioHorasVooRemoto = function (
                    accessToken,
                    requestJson,
                    callback
                ) {
                    Visualforce.remoting.Manager.invokeAction(
                        '{!$RemoteAction.ControleHorasVooController.gerarRelatorioHoras}',
                        accessToken,
                        requestJson,
                        callback,
                        { escape: true, timeout: 120000 }
                    );
                };

                // Download da nota anexada no PlaneIT.
                // O arquivo fica no storage da Planeit; aqui apenas pedimos uma
                // URL assinada (válida por 1 hora) e deixamos o navegador baixar.
                window.ControleHorasVooAnexo = {
                    baixar: function (abastecimentoId, elemento) {
                        if (!abastecimentoId) {
                            return;
                        }
                        if (elemento) {
                            if (elemento.getAttribute('data-carregando') === '1') {
                                return;
                            }
                            // Alterna atributo em vez de trocar innerHTML, que
                            // destruiria o SVG do ícone.
                            elemento.setAttribute('data-carregando', '1');
                        }

                        var restaurar = function () {
                            if (elemento) {
                                elemento.setAttribute('data-carregando', '0');
                            }
                        };

                        Visualforce.remoting.Manager.invokeAction(
                            '{!$RemoteAction.ControleHorasVooController.obterUrlAnexo}',
                            window.controleHorasVooAccessToken,
                            abastecimentoId,
                            function (url) {
                                restaurar();
                                if (url) {
                                    // A URL vem com content-disposition=attachment,
                                    // então baixa sem tirar o usuário da página.
                                    window.location.href = url;
                                } else {
                                    alert('Não foi possível abrir a nota anexada. Atualize a página e tente novamente.');
                                }
                            },
                            { escape: false, timeout: 30000 }
                        );
                    }
                };
            </script>
            
            <apex:form id="mainForm">
                <apex:outputPanel id="pageMessagesPanel">
                    <apex:pageMessages />
                </apex:outputPanel>
                
                <!-- ActionFunction para exclusão de voo -->
                <apex:actionFunction name="excluirVooAF" 
                                     action="{!excluirControle}" 
                                     reRender="workspacePanel,pageMessagesPanel"
                                     status="loadingStatus">
                    <apex:param name="controleId" assignTo="{!controleIdParaExcluir}" value=""/>
                </apex:actionFunction>

                <apex:actionFunction name="atualizarPeriodoCalendarioAF"
                                     action="{!aplicarFiltrosCalendario}"
                                     reRender="pageMessagesPanel,calendarioPanel,manutencaoPanel"
                                     status="loadingStatus"
                                     oncomplete="ControleHorasVoo.finalizarAtualizacaoPeriodo(); onTabChange();"/>
                
                <apex:outputPanel id="workspacePanel" layout="block" styleClass="controle-horas-container">
                    <div class="main-container">
                        
                        <!-- Cabeçalho -->
                        <div class="header-section">
                            <h1>✈ Controle de Horas Operacionais</h1>
                            <p>Sistema de Gestão de Aeronaves - Engemap</p>
                        </div>
                        
                        <!-- Sistema de abas moderno -->
                        <div class="tabs-container">
                            <div class="tabs-nav" role="tablist" aria-label="Seções do controle de horas">
                                <!-- Botão de ação primária - Destaque à esquerda -->
                                <apex:commandButton styleClass="tab-button action-primary {!IF(abaAtiva == 'novo', 'active', '')}" 
                                                    id="tabNovo"
                                                    value="+ Novo Registro" 
                                                    action="{!trocarAba}"
                                                    reRender="workspacePanel,pageMessagesPanel"
                                                    status="loadingStatus"
                                                    html-role="tab"
                                                    html-aria-selected="{!IF(abaAtiva == 'novo', 'true', 'false')}"
                                                    html-aria-controls="panelNovo"
                                                    oncomplete="onTabChange();">
                                    <apex:param name="aba" value="novo"/>
                                </apex:commandButton>
                                
                                <!-- Separador visual -->
                                <div class="tabs-separator"></div>
                                
                                <!-- Abas de navegação regulares -->
                                <apex:commandButton styleClass="tab-button {!IF(abaAtiva == 'controles', 'active', '')}" 
                                                    id="tabControles"
                                                    value="Calendário" 
                                                    action="{!trocarAba}"
                                                    reRender="workspacePanel,pageMessagesPanel"
                                                    status="loadingStatus"
                                                    html-role="tab"
                                                    html-aria-selected="{!IF(abaAtiva == 'controles', 'true', 'false')}"
                                                    html-aria-controls="panelControles"
                                                    oncomplete="onTabChange();">
                                    <apex:param name="aba" value="controles"/>
                                </apex:commandButton>
                                
                                <apex:commandButton styleClass="tab-button {!IF(abaAtiva == 'manutencao', 'active', '')}"
                                                    id="tabManutencao"
                                                    value="Controle Técnico"
                                                    action="{!trocarAba}"
                                                    reRender="workspacePanel,pageMessagesPanel"
                                                    status="loadingStatus"
                                                    html-role="tab"
                                                    html-aria-selected="{!IF(abaAtiva == 'manutencao', 'true', 'false')}"
                                                    html-aria-controls="panelManutencao"
                                                    oncomplete="onTabChange();">
                                    <apex:param name="aba" value="manutencao"/>
                                </apex:commandButton>

                                <apex:commandButton styleClass="tab-button {!IF(abaAtiva == 'aeronaves', 'active', '')}"
                                                    id="tabAeronaves"
                                                    value="Aeronaves"
                                                    action="{!trocarAba}"
                                                    reRender="workspacePanel,pageMessagesPanel"
                                                    status="loadingStatus"
                                                    html-role="tab"
                                                    html-aria-selected="{!IF(abaAtiva == 'aeronaves', 'true', 'false')}"
                                                    html-aria-controls="panelAeronaves"
                                                    oncomplete="onTabChange();">
                                    <apex:param name="aba" value="aeronaves"/>
                                </apex:commandButton>
                            </div>
                            
                            <div class="tab-content">
                                <!-- === ABA: CALENDÁRIO (antes: Controles Cadastrados) === -->
                                <div id="panelControles"
                                     class="tab-pane {!IF(abaAtiva == 'controles', 'active', '')}"
                                     role="tabpanel"
                                     aria-label="Calendário"
                                     aria-hidden="{!IF(abaAtiva == 'controles', 'false', 'true')}">
                                    
                                    <!-- Filtros do Calendário -->
                                    <apex:outputPanel id="filtroPanel">
                                    <div class="calendario-filtros">
                                        <!-- Botão Sincronizar - Posição Absoluta no Canto Superior Direito -->
                                        <apex:commandButton value="↻ Sincronizar" 
                                                            action="{!sincronizarVoosPlaneit}" 
                                                            styleClass="btn-sincronizar-ghost"
                                                            reRender="workspacePanel,pageMessagesPanel"
                                                            status="loadingStatus"
                                                            title="Sincronizar voos do Planeit para o período selecionado"/>
                                        
                                        <div class="filtros-titulo">Registros de Voos</div>
                                        <div class="filtros-linha">
                                            <div class="filtro-grupo filtro-aeronave">
                                                <label class="form-label required">Aeronave</label>
                                                <apex:selectList value="{!filtroAeronaveIdCalendario}" size="1" styleClass="form-select">
                                                    <apex:selectOptions value="{!aeronaveOptions}"/>
                                                </apex:selectList>
                                            </div>
                                            <div class="filtro-grupo">
                                                <label class="form-label">Ano</label>
                                                <apex:selectList value="{!filtroAnoCalendario}"
                                                                 size="1"
                                                                 styleClass="form-select calendar-year"
                                                                 onchange="ControleHorasVoo.agendarAtualizacaoPeriodo();">
                                                    <apex:selectOptions value="{!anosDisponiveisCalendario}"/>
                                                </apex:selectList>
                                            </div>
                                            <div class="filtro-grupo">
                                                <label class="form-label">Mês</label>
                                                <apex:selectList value="{!filtroMesCalendario}"
                                                                 size="1"
                                                                 styleClass="form-select calendar-month"
                                                                 onchange="ControleHorasVoo.agendarAtualizacaoPeriodo();">
                                                    <apex:selectOptions value="{!mesesDisponiveis}"/>
                                                </apex:selectList>
                                            </div>
                                            <div class="filtro-grupo filtro-acoes">
                                                <label class="form-label" style="opacity: 0;">Ações</label>
                                                <div class="acoes-calendario">
                                                    <apex:commandButton value="Aplicar" 
                                                                        action="{!aplicarFiltrosCalendario}" 
                                                                        styleClass="btn btn-primary"
                                                                        reRender="pageMessagesPanel,filtroPanel,calendarioPanel,manutencaoPanel"
                                                                        status="loadingStatus"
                                                                        oncomplete="onTabChange();"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    </apex:outputPanel>
                                    
                                    <!-- Panel do Calendário -->
                                    <apex:outputPanel id="calendarioPanel">
                                        <apex:outputPanel rendered="{!AND(diasCalendario.size > 0, NOT(ISBLANK(filtroAeronaveIdCalendario)))}">
                                            
                                            <!-- Grid do Calendário -->
                                            <div class="calendario-container">
                                                <div class="calendario-header">
                                                    <div class="dia-semana">Dom</div>
                                                    <div class="dia-semana">Seg</div>
                                                    <div class="dia-semana">Ter</div>
                                                    <div class="dia-semana">Qua</div>
                                                    <div class="dia-semana">Qui</div>
                                                    <div class="dia-semana">Sex</div>
                                                    <div class="dia-semana">Sáb</div>
                                                </div>
                                                <div class="calendario-grid">
                                                    <apex:repeat value="{!diasCalendario}" var="dia">
                                                        <div class="dia-celula {!dia.cssClass}">
                                                            
                                                            <!-- Conteúdo do dia com scroll -->
                                                            <div class="dia-conteudo">
                                                                <div class="dia-numero">{!dia.numero}</div>
                                                                
                                                                <!-- Contador de voos - SEMPRE VISÍVEL quando há voos -->
                                                                <apex:outputPanel rendered="{!dia.temVoo}">
                                                                    <div class="contador-voos" title="{!dia.controles.size} voo{!IF(dia.controles.size > 1, 's', '')} realizado{!IF(dia.controles.size > 1, 's', '')}">{!dia.controles.size}</div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Múltiplos voos por dia com status individual -->
                                                                <apex:outputPanel rendered="{!dia.temVoo}">
                                                                    <apex:repeat value="{!dia.controles}" var="controle">
                                                                        <div class="voo-info">
                                                                            <div class="piloto-nome" title="Piloto: {!IF(ISBLANK(controle.controle.Piloto__r.Name), controle.controle.Piloto_Externo__c, controle.controle.Piloto__r.Name)}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controle.controle.Piloto__r.Name), controle.controle.Piloto_Externo__c, controle.controle.Piloto__r.Name)}"/>
                                                                                <apex:outputPanel rendered="{!AND(ISBLANK(controle.controle.Piloto__r.Name), NOT(ISBLANK(controle.controle.Piloto_Externo__c)))}">
                                                                                    <span class="badge-externo">externo</span>
                                                                                </apex:outputPanel>
                                                                            </div>
                                                                            <apex:outputPanel rendered="{!OR(NOT(ISBLANK(controle.controle.Operador__r.Name)), NOT(ISBLANK(controle.controle.Operador_Externo__c)))}">
                                                                                <div class="operador" title="Operador: {!IF(ISBLANK(controle.controle.Operador__r.Name), controle.controle.Operador_Externo__c, controle.controle.Operador__r.Name)}">
                                                                                    <apex:outputText value="{!IF(ISBLANK(controle.controle.Operador__r.Name), controle.controle.Operador_Externo__c, controle.controle.Operador__r.Name)}"/>
                                                                                    <apex:outputPanel rendered="{!AND(ISBLANK(controle.controle.Operador__r.Name), NOT(ISBLANK(controle.controle.Operador_Externo__c)))}">
                                                                                        <span class="badge-externo">externo</span>
                                                                                    </apex:outputPanel>
                                                                                </div>
                                                                            </apex:outputPanel>
                                                                            <div class="horas-voo" title="Horas de voo">
                                                                                <span>
                                                                                    <apex:outputText value="{0, number, #,##0.0}">
                                                                                        <apex:param value="{!controle.controle.Horas_voo__c}"/>
                                                                                    </apex:outputText>h
                                                                                </span>
                                                                            </div>
                                                                            <apex:outputPanel rendered="{!NOT(ISBLANK(controle.controle.Tipo__c))}">
                                                                                <span class="tipo-voo tipo-{!controle.controle.Tipo__c}" title="Tipo: {!IF(controle.controle.Tipo__c == 'AB', 'Abastecimento', controle.controle.Tipo__c)}">
                                                                                    <apex:outputText value="{!IF(controle.controle.Tipo__c == 'AB', 'ABASTECIMENTO', controle.controle.Tipo__c)}"/>
                                                                                </span>
                                                                            </apex:outputPanel>
                                                                            <apex:outputPanel rendered="{!AND(NOT(ISBLANK(controle.controle.DEP__c)), NOT(ISBLANK(controle.controle.ARR__c)))}">
                                                                                <div class="rota" title="Acionamento: {!IF(controle.controle.Acionamento__c != null, LEFT(TEXT(controle.controle.Acionamento__c), 5), '--:--')} → Corte: {!IF(controle.controle.Corte__c != null, LEFT(TEXT(controle.controle.Corte__c), 5), '--:--')} | DEP: {!controle.controle.DEP__c} → ARR: {!controle.controle.ARR__c}">
                                                                                    {!IF(controle.controle.Acionamento__c != null, LEFT(TEXT(controle.controle.Acionamento__c), 5), '--:--')} - {!IF(controle.controle.Corte__c != null, LEFT(TEXT(controle.controle.Corte__c), 5), '--:--')} | {!controle.controle.DEP__c} → {!controle.controle.ARR__c}
                                                                                </div>
                                                                            </apex:outputPanel>
                                                                            <apex:outputPanel rendered="{!controle.temAbastecimento}">
                                                                                <apex:repeat value="{!controle.abastecimentos}" var="ab">
                                                                                    <div class="combustivel-info">
                                                                                        <apex:outputText value="{!IF(ab.Faturado__c, '✓', '✕')} "/>
                                                                                        <apex:outputText value="{0, number, #,##0.0}L">
                                                                                            <apex:param value="{!ab.Quantidade__c}"/>
                                                                                        </apex:outputText>
                                                                                        <apex:outputPanel rendered="{!AND(ab.Custo_Total__c != null, ab.Custo_Total__c > 0)}">
                                                                                            <apex:outputText value=" • R$ {0, number, #,##0.00}">
                                                                                                <apex:param value="{!ab.Custo_Total__c}"/>
                                                                                            </apex:outputText>
                                                                                        </apex:outputPanel>
                                                                                    </div>
                                                                                </apex:repeat>
                                                                            </apex:outputPanel>
                                                                            <div class="descricao-voo" title="Descrição: {!controle.controle.Descricao__c}">{!controle.controle.Descricao__c}</div>
                                                                            
                                                                            <!-- Status de Faturamento (baseado nos abastecimentos filhos) -->
                                                                            <!-- Exibe somente se houver abastecimentos; faturado somente se TODOS estiverem faturados -->
                                                                            <apex:outputPanel rendered="{!controle.temAbastecimento}">
                                                                                <apex:outputPanel rendered="{!controle.todosFaturados}">
                                                                                    <div class="status-faturamento status-faturado" title="{!IF(controle.qtdAbastecimentos > 1, 'Todos os abastecimentos foram faturados', 'Abastecimento faturado')}">✓ Faturado</div>
                                                                                </apex:outputPanel>
                                                                                <apex:outputPanel rendered="{!NOT(controle.todosFaturados)}">
                                                                                    <div class="status-faturamento status-nao-faturado" title="{!IF(controle.qtdAbastecimentos > 1, 'Há abastecimentos não faturados neste voo', 'Abastecimento ainda não faturado')}">✕ Não Faturado</div>
                                                                                </apex:outputPanel>
                                                                            </apex:outputPanel>
                                                                        </div>
                                                                    </apex:repeat>
                                                                </apex:outputPanel>
                                                            </div>
                                                            
                                                            <!-- Rodapé fixo com botões de ação -->
                                                            <div class="dia-rodape">
                                                                <div class="dia-acoes">
                                                                    <apex:outputPanel rendered="{!dia.temVoo}">
                                                                        <apex:commandButton value="Ver" 
                                                                                            title="Visualizar detalhes dos voos"
                                                                                            action="{!visualizarDia}" 
                                                                                            styleClass="btn-acao btn-visualizar"
                                                                                            reRender="modalPanel"
                                                                                            status="loadingStatus">
                                                                            <apex:param name="dia" value="{!dia.numero}"/>
                                                                        </apex:commandButton>
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered="{!dia.doMesAtual}">
                                                                        <apex:commandButton value="+" 
                                                                                            title="Adicionar novo voo"
                                                                                            action="{!novoVooDia}" 
                                                                                            styleClass="btn-acao btn-adicionar"
                                                                                            reRender="workspacePanel,pageMessagesPanel"
                                                                                            status="loadingStatus"
                                                                                            oncomplete="onTabChange();">
                                                                            <apex:param name="dia" value="{!dia.numero}"/>
                                                                        </apex:commandButton>
                                                                    </apex:outputPanel>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </apex:repeat>
                                                </div>
                                            </div>
                                            
                                        </apex:outputPanel>
                                        
                                        <!-- Dashboard inicial da frota -->
                                        <apex:outputPanel rendered="{!ISBLANK(filtroAeronaveIdCalendario)}">
                                            <section class="flight-dashboard" aria-labelledby="flightDashboardTitle">
                                                <header class="flight-dashboard-header">
                                                    <div>
                                                        <span class="flight-dashboard-eyebrow">Visão geral da frota</span>
                                                        <h2 id="flightDashboardTitle">Distribuição das horas de voo</h2>
                                                        <p>{!periodoDashboard}</p>
                                                    </div>
                                                    <div class="flight-dashboard-actions">
                                                        <div class="flight-dashboard-summary" aria-label="Resumo do período">
                                                            <div>
                                                                <strong>{!totalVoosDashboard}</strong>
                                                                <span>voos</span>
                                                            </div>
                                                            <div>
                                                                <strong>
                                                                    <apex:outputText value="{0, number, #,##0.0}">
                                                                        <apex:param value="{!totalHorasDashboard}"/>
                                                                    </apex:outputText>
                                                                </strong>
                                                                <span>horas</span>
                                                            </div>
                                                        </div>
                                                        <button type="button"
                                                                class="btn btn-outline-primary flight-report-open"
                                                                title="Exportar relatório de horas">
                                                            <span class="report-export-icon" aria-hidden="true">↓</span>
                                                            Exportar
                                                        </button>
                                                    </div>
                                                </header>

                                                <apex:outputPanel rendered="{!temDashboardAeronaves}">
                                                    <div class="flight-dashboard-grid">
                                                        <apex:repeat value="{!dashboardAeronaves}" var="dashboardItem">
                                                            <article class="flight-dashboard-card">
                                                                <div class="flight-dashboard-card-header">
                                                                    <h3>{!dashboardItem.nome}</h3>
                                                                    <span>{!dashboardItem.totalVoos} voos</span>
                                                                </div>

                                                                <div class="flight-dashboard-chart-wrap {!IF(dashboardItem.temVoos, '', 'is-empty')}">
                                                                    <canvas class="flight-dashboard-chart"
                                                                            role="img"
                                                                            aria-label="Distribuição das horas de voo da aeronave {!dashboardItem.nome}">
                                                                    </canvas>
                                                                    <div class="flight-dashboard-chart-data" hidden="hidden">
                                                                        <apex:repeat value="{!dashboardItem.metricas}" var="metrica">
                                                                            <span data-flight-code="{!metrica.codigo}"
                                                                                  data-flight-label="{!metrica.nome}"
                                                                                  data-flight-color="{!metrica.cor}"
                                                                                  data-flight-hours="{!metrica.horasData}">
                                                                            </span>
                                                                        </apex:repeat>
                                                                    </div>
                                                                    <div class="flight-dashboard-chart-total" aria-hidden="true">
                                                                        <strong>
                                                                            <apex:outputText value="{0, number, #,##0.0}">
                                                                                <apex:param value="{!dashboardItem.totalHoras}"/>
                                                                            </apex:outputText>
                                                                        </strong>
                                                                        <span>horas</span>
                                                                    </div>
                                                                </div>

                                                                <apex:outputPanel rendered="{!!dashboardItem.temVoos}"
                                                                                  layout="block"
                                                                                  styleClass="flight-dashboard-no-data">
                                                                    Sem voos no período
                                                                </apex:outputPanel>

                                                                <apex:commandLink action="{!abrirCalendarioDashboard}"
                                                                                  styleClass="btn btn-primary flight-dashboard-action"
                                                                                  reRender="pageMessagesPanel,filtroPanel,calendarioPanel,manutencaoPanel"
                                                                                  status="loadingStatus"
                                                                                  oncomplete="onTabChange();">
                                                                    <span class="flight-dashboard-action-icon" aria-hidden="true"></span>
                                                                    Ver calendário
                                                                    <apex:param name="aeronaveDashboardId" value="{!dashboardItem.aeronaveId}"/>
                                                                </apex:commandLink>
                                                            </article>
                                                        </apex:repeat>
                                                    </div>

                                                    <footer class="flight-dashboard-legend" aria-label="Legenda dos tipos de voo">
                                                        <span class="flight-dashboard-legend-title">Tipos de voo</span>
                                                        <ul>
                                                            <apex:repeat value="{!legendaTiposVoo}" var="tipoVoo">
                                                                <li>
                                                                    <span class="flight-dashboard-swatch"
                                                                          style="background-color: {!tipoVoo.cor};"
                                                                          aria-hidden="true"></span>
                                                                    <strong>{!tipoVoo.codigo}</strong>
                                                                    <span>{!tipoVoo.nome}</span>
                                                                </li>
                                                            </apex:repeat>
                                                        </ul>
                                                    </footer>
                                                </apex:outputPanel>

                                                <apex:outputPanel rendered="{!!temDashboardAeronaves}">
                                                    <div class="empty-state">
                                                        <h3>Nenhuma aeronave ativa</h3>
                                                        <p>Cadastre ou ative uma aeronave para visualizar o resumo mensal.</p>
                                                    </div>
                                                </apex:outputPanel>
                                            </section>
                                        </apex:outputPanel>
                                    </apex:outputPanel>
                                    
                                    <!-- Modal de Detalhes -->
                                    <apex:outputPanel id="modalPanel">
                                        <apex:outputPanel rendered="{!exibirModal}">
                                            <div class="modal-overlay" onclick="fecharModalJs();">
                                                <div class="modal-content"
                                                     role="dialog"
                                                     aria-modal="true"
                                                     aria-labelledby="modalTitle"
                                                     tabindex="-1"
                                                     onclick="event.stopPropagation();">
                                                    <div class="modal-header">
                                                        <h3 id="modalTitle">
                                                            <apex:outputPanel rendered="{!controlesDetalhes.size <= 1}">
                                                                Detalhes do Voo - Dia {!diaSelecionado} ({!nomeDiaSemana})
                                                            </apex:outputPanel>
                                                            <apex:outputPanel rendered="{!controlesDetalhes.size > 1}">
                                                                Voos do Dia {!diaSelecionado} ({!nomeDiaSemana}) - {!controlesDetalhes.size} voos
                                                            </apex:outputPanel>
                                                        </h3>
                                                        <apex:commandButton value="×" 
                                                                            action="{!fecharModal}" 
                                                                            styleClass="btn-fechar-modal"
                                                                            html-aria-label="Fechar detalhes do voo"
                                                                            reRender="modalPanel"
                                                                            oncomplete="document.dispatchEvent(new CustomEvent('chv:modal-closed'));"/>
                                                    </div>
                                                    <div class="modal-body">
                                                        <apex:outputPanel rendered="{!controlesDetalhes.size > 0}">
                                                            <apex:repeat value="{!controlesDetalhes}" var="controleItem" id="controleRepeat">
                                                                
                                                                <!-- Cabeçalho por voo (apenas em dia com múltiplos voos) -->
                                                                <apex:outputPanel rendered="{!controlesDetalhes.size > 1}">
                                                                    <div class="voo-cabecalho-modal">
                                                                        <p class="voo-cabecalho-titulo">
                                                                            <apex:outputText value="{!IF(ISBLANK(controleItem.Piloto__r.Name), IF(ISBLANK(controleItem.Piloto_Externo__c), 'Piloto não informado', controleItem.Piloto_Externo__c), controleItem.Piloto__r.Name)}"/>
                                                                            <apex:outputPanel rendered="{!AND(ISBLANK(controleItem.Piloto__r.Name), NOT(ISBLANK(controleItem.Piloto_Externo__c)))}">
                                                                                <span class="badge-externo">externo</span>
                                                                            </apex:outputPanel>
                                                                        </p>
                                                                        <p class="voo-cabecalho-sub">
                                                                            <apex:outputText value="{0, number, #,##0.0}"><apex:param value="{!controleItem.Horas_voo__c}"/></apex:outputText> h de voo
                                                                        </p>
                                                                    </div>
                                                                </apex:outputPanel>
                                                                
                                                                <!-- Metadado: quando e por quem foi registrado -->
                                                                <div class="modal-metadado">
                                                                    <strong>Registrado em:</strong>
                                                                    <apex:outputField value="{!controleItem.CreatedDate}"/>
                                                                    <apex:outputPanel rendered="{!controleItem.Usuario_Alteracao__c != null}">
                                                                        &nbsp;|&nbsp;<strong>por:</strong>&nbsp;{!controleItem.Usuario_Alteracao__r.Name}
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered="{!AND(controleItem.Usuario_Alteracao__c == null, controleItem.Contato_Alteracao__c != null)}">
                                                                        &nbsp;|&nbsp;<strong>por:</strong>&nbsp;{!controleItem.Contato_Alteracao__r.Name}
                                                                    </apex:outputPanel>
                                                                    <apex:outputPanel rendered="{!AND(controleItem.Usuario_Alteracao__c == null, controleItem.Contato_Alteracao__c == null)}">
                                                                        &nbsp;|&nbsp;<strong>por:</strong>&nbsp;PlaneIT
                                                                    </apex:outputPanel>
                                                                </div>
                                                                
                                                                <!-- Seção 1: Identificação -->
                                                                <div class="modal-secao">
                                                                    <p class="modal-secao-titulo">Identificação</p>
                                                                    <div class="detalhes-grid">
                                                                        <div class="detalhe-item">
                                                                            <label>Data do Voo</label>
                                                                            <span>
                                                                                <apex:outputText value="{0, date, dd/MM/yyyy}">
                                                                                    <apex:param value="{!controleItem.Data_do_Voo__c}"/>
                                                                                </apex:outputText>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Aeronave</label>
                                                                            <span class="{!IF(ISBLANK(controleItem.Aeronave__r.Name), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controleItem.Aeronave__r.Name), 'Não preenchido', controleItem.Aeronave__r.Name)}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Piloto</label>
                                                                            <span class="{!IF(AND(ISBLANK(controleItem.Piloto__r.Name), ISBLANK(controleItem.Piloto_Externo__c)), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controleItem.Piloto__r.Name), IF(ISBLANK(controleItem.Piloto_Externo__c), 'Não preenchido', controleItem.Piloto_Externo__c), controleItem.Piloto__r.Name)}"/>
                                                                                <apex:outputPanel rendered="{!AND(ISBLANK(controleItem.Piloto__r.Name), NOT(ISBLANK(controleItem.Piloto_Externo__c)))}">
                                                                                    <span class="badge-externo">externo</span>
                                                                                </apex:outputPanel>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Operador</label>
                                                                            <span class="{!IF(AND(ISBLANK(controleItem.Operador__r.Name), ISBLANK(controleItem.Operador_Externo__c)), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controleItem.Operador__r.Name), IF(ISBLANK(controleItem.Operador_Externo__c), 'Não preenchido', controleItem.Operador_Externo__c), controleItem.Operador__r.Name)}"/>
                                                                                <apex:outputPanel rendered="{!AND(ISBLANK(controleItem.Operador__r.Name), NOT(ISBLANK(controleItem.Operador_Externo__c)))}">
                                                                                    <span class="badge-externo">externo</span>
                                                                                </apex:outputPanel>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                
                                                                <!-- Seção 2: Tipo e Rota -->
                                                                <div class="modal-secao">
                                                                    <p class="modal-secao-titulo">Tipo e Rota</p>
                                                                    <div class="detalhes-grid">
                                                                        <div class="detalhe-item">
                                                                            <label>Tipo</label>
                                                                            <span class="{!IF(ISBLANK(controleItem.Tipo__c), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controleItem.Tipo__c), 'Não preenchido', controleItem.Tipo__c)}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Rota</label>
                                                                            <span class="{!IF(AND(ISBLANK(controleItem.DEP__c), ISBLANK(controleItem.ARR__c)), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(AND(ISBLANK(controleItem.DEP__c), ISBLANK(controleItem.ARR__c)), 'Não preenchido', controleItem.DEP__c & ' → ' & controleItem.ARR__c)}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item detalhe-full">
                                                                            <label>Descrição</label>
                                                                            <span class="{!IF(ISBLANK(controleItem.Descricao__c), 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(ISBLANK(controleItem.Descricao__c), 'Não preenchido', controleItem.Descricao__c)}"/>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                
                                                                <!-- Seção 3: Horários -->
                                                                <div class="modal-secao">
                                                                    <p class="modal-secao-titulo">Horários</p>
                                                                    <div class="detalhes-grid">
                                                                        <div class="detalhe-item">
                                                                            <label>Acionamento</label>
                                                                            <span class="{!IF(controleItem.Acionamento__c == null, 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(controleItem.Acionamento__c != null, LEFT(TEXT(controleItem.Acionamento__c), 5), 'Não preenchido')}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Corte</label>
                                                                            <span class="{!IF(controleItem.Corte__c == null, 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(controleItem.Corte__c != null, LEFT(TEXT(controleItem.Corte__c), 5), 'Não preenchido')}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>TOT</label>
                                                                            <span class="{!IF(controleItem.TOT__c == null, 'detalhe-valor-vazio', '')}">
                                                                                <apex:outputText value="{!IF(controleItem.TOT__c != null, SUBSTITUTE(TEXT(controleItem.TOT__c), '.', ':'), 'Não preenchido')}"/>
                                                                            </span>
                                                                        </div>
                                                                        <div class="detalhe-item">
                                                                            <label>Horas de Voo</label>
                                                                            <span>
                                                                                <apex:outputText value="{0, number, #,##0.0}">
                                                                                    <apex:param value="{!controleItem.Horas_voo__c}"/>
                                                                                </apex:outputText> h
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                
                                                                <!-- Seção 4: Abastecimentos -->
                                                                <div class="modal-secao">
                                                                    <p class="modal-secao-titulo">Abastecimentos</p>
                                                                    <div class="abastecimentos-detalhe">
                                                                        <apex:outputPanel rendered="{!controleItem.Abastecimentos__r.size > 0}">
                                                                            <div class="abastecimentos-lista">
                                                                                <table class="tabela-abast">
                                                                                    <thead>
                                                                                        <tr>
                                                                                            <th>Local</th>
                                                                                            <th>O/D</th>
                                                                                            <th>Tipo</th>
                                                                                            <th>Qtd (L)</th>
                                                                                            <th>R$/L</th>
                                                                                            <th>Total (R$)</th>
                                                                                            <th>Nota Fiscal</th>
                                                                                            <th>Faturado</th>
                                                                                        </tr>
                                                                                    </thead>
                                                                                    <tbody>
                                                                                        <apex:repeat value="{!controleItem.Abastecimentos__r}" var="ab">
                                                                                            <tr>
                                                                                                <td>
                                                                                                    <span class="{!IF(ISBLANK(ab.Local__c), 'abast-valor-vazio', '')}">
                                                                                                        <apex:outputText value="{!IF(ISBLANK(ab.Local__c), '—', ab.Local__c)}"/>
                                                                                                    </span>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <span class="{!IF(ISBLANK(ab.Origem_Destino__c), 'abast-valor-vazio', '')}">
                                                                                                        <apex:outputText value="{!IF(ISBLANK(ab.Origem_Destino__c), '—', ab.Origem_Destino__c)}"/>
                                                                                                    </span>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <span class="{!IF(ISBLANK(ab.Tipo_Combustivel__c), 'abast-valor-vazio', '')}">
                                                                                                        <apex:outputText value="{!IF(ISBLANK(ab.Tipo_Combustivel__c), '—', ab.Tipo_Combustivel__c)}"/>
                                                                                                    </span>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <apex:outputPanel rendered="{!ab.Quantidade__c != null}">
                                                                                                        <apex:outputText value="{0, number, #,##0.00}">
                                                                                                            <apex:param value="{!ab.Quantidade__c}"/>
                                                                                                        </apex:outputText>
                                                                                                    </apex:outputPanel>
                                                                                                    <apex:outputPanel rendered="{!ab.Quantidade__c == null}">
                                                                                                        <span class="abast-valor-vazio">—</span>
                                                                                                    </apex:outputPanel>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <apex:outputPanel rendered="{!ab.Custo_Unitario__c != null}">
                                                                                                        <apex:outputText value="{0, number, #,##0.00}">
                                                                                                            <apex:param value="{!ab.Custo_Unitario__c}"/>
                                                                                                        </apex:outputText>
                                                                                                    </apex:outputPanel>
                                                                                                    <apex:outputPanel rendered="{!ab.Custo_Unitario__c == null}">
                                                                                                        <span class="abast-valor-vazio">—</span>
                                                                                                    </apex:outputPanel>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <apex:outputPanel rendered="{!ab.Custo_Total__c != null}">
                                                                                                        <apex:outputText value="{0, number, #,##0.00}">
                                                                                                            <apex:param value="{!ab.Custo_Total__c}"/>
                                                                                                        </apex:outputText>
                                                                                                    </apex:outputPanel>
                                                                                                    <apex:outputPanel rendered="{!ab.Custo_Total__c == null}">
                                                                                                        <span class="abast-valor-vazio">—</span>
                                                                                                    </apex:outputPanel>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <!-- A Planeit usa documentoReferencia ou delivery_receipt_code
                                                                                                         conforme o fornecedor; exibimos o que vier preenchido. -->
                                                                                                    <span class="{!IF(AND(ISBLANK(ab.Documento_Referencia__c), ISBLANK(ab.Numero_Recibo__c)), 'abast-valor-vazio', '')}">
                                                                                                        <apex:outputText value="{!IF(NOT(ISBLANK(ab.Documento_Referencia__c)), ab.Documento_Referencia__c, IF(NOT(ISBLANK(ab.Numero_Recibo__c)), ab.Numero_Recibo__c, '—'))}"/>
                                                                                                    </span>
                                                                                                    <apex:outputPanel rendered="{!NOT(ISBLANK(ab.Caminho_Anexo__c))}" layout="none">
                                                                                                        <a href="javascript:void(0)"
                                                                                                           class="anexo-nota-link"
                                                                                                           title="Baixar a nota anexada no PlaneIT"
                                                                                                           onclick="ControleHorasVooAnexo.baixar('{!JSENCODE(ab.Id)}', this);"><svg class="anexo-nota-icone" viewBox="0 0 520 520" aria-hidden="true" focusable="false"><path d="M176 367c6 6 15 5 21 0l100-100a20 20 0 0 1 28 0c9 8 8 22 0 30L202 418a70 70 0 0 1-99 0l-1-1a70 70 0 0 1 0-99l217-217a70 70 0 0 1 99 0l1 1a70 70 0 0 1 0 99l-1 1c-5 5-6 12-2 18a150 150 0 0 1 14 35c2 8 11 10 17 5l15-16a131 131 0 0 0 0-185h-2a131 131 0 0 0-185 0L58 275a131 131 0 0 0 0 185l2 2a130 130 0 0 0 184 0l124-123a81 81 0 1 0-117-113l-98 98c-6 6-6 16 0 22z"/></svg></a>
                                                                                                    </apex:outputPanel>
                                                                                                    <apex:outputPanel rendered="{!NOT(ISBLANK(ab.Observacoes__c))}" layout="block">
                                                                                                        <span class="abast-fornecedor">
                                                                                                            <apex:outputText value="{!ab.Observacoes__c}"/>
                                                                                                        </span>
                                                                                                    </apex:outputPanel>
                                                                                                </td>
                                                                                                <td>
                                                                                                    <apex:commandLink action="{!alternarFaturamentoAbastecimento}"
                                                                                                                      reRender="modalPanel,calendarioPanel,manutencaoPanel"
                                                                                                                      status="loadingStatus"
                                                                                                                      title="{!IF(ab.Faturado__c, 'Clique para desmarcar como faturado', 'Clique para marcar como faturado')}"
                                                                                                                      styleClass="{!IF(ab.Faturado__c, 'badge-faturado', 'badge-nao-faturado')}">
                                                                                                        <apex:param name="abastecimentoId" value="{!ab.Id}"/>
                                                                                                        {!IF(ab.Faturado__c, '✓ Faturado', '✕ Pendente')}
                                                                                                    </apex:commandLink>
                                                                                                </td>
                                                                                            </tr>
                                                                                        </apex:repeat>
                                                                                    </tbody>
                                                                                </table>
                                                                            </div>
                                                                        </apex:outputPanel>
                                                                        <apex:outputPanel rendered="{!controleItem.Abastecimentos__r.size == 0}">
                                                                            <div class="sem-abastecimento-placeholder">Nenhum abastecimento registrado</div>
                                                                        </apex:outputPanel>
                                                                    </div>
                                                                </div>
                                                                
                                                                <!-- Ações individuais para cada voo -->
                                                                <div class="acoes-voo-individual">
                                                                    <apex:commandButton value="Editar" 
                                                                                        action="{!editarControle}" 
                                                                                        styleClass="btn btn-primary"
                                                                                        reRender="workspacePanel,pageMessagesPanel"
                                                                                        oncomplete="toggleModoAbastecimento('{!somenteAbastecimento}' === 'true'); onTabChange();">
                                                                        <apex:param name="controleId" value="{!controleItem.Id}"/>
                                                                    </apex:commandButton>
                                                                    <button type="button" 
                                                                            class="btn btn-danger"
                                                                            onclick="if(confirm('Tem certeza que deseja excluir este voo? Esta ação não pode ser desfeita.')) { excluirVooAF('{!controleItem.Id}'); }">
                                                                        Excluir
                                                                    </button>
                                                                </div>
                                                                
                                                                <!-- Separador entre voos -->
                                                                <apex:outputPanel rendered="{!controlesDetalhes.size > 1}">
                                                                    <div class="voo-separador-modal"></div>
                                                                </apex:outputPanel>
                                                            </apex:repeat>
                                                        </apex:outputPanel>
                                                        
                                                        <apex:outputPanel rendered="{!controlesDetalhes.size == 0}">
                                                            <div class="sem-voo-info">
                                                                <p>📅 Não há voo registrado para este dia.</p>
                                                                <p>Clique em "Adicionar Voo" para criar um novo registro.</p>
                                                            </div>
                                                        </apex:outputPanel>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <apex:outputPanel rendered="{!controlesDetalhes.size == 0}">
                                                            <apex:commandButton value="+ Adicionar Voo" 
                                                                                action="{!novoVooDia}" 
                                                                                styleClass="btn btn-success"
                                                                                reRender="workspacePanel,pageMessagesPanel"
                                                                                oncomplete="onTabChange();">
                                                                <apex:param name="dia" value="{!diaSelecionado}"/>
                                                            </apex:commandButton>
                                                        </apex:outputPanel>
                                                        <apex:outputPanel rendered="{!controlesDetalhes.size > 0}">
                                                            <apex:commandButton value="+ Adicionar Outro Voo" 
                                                                                action="{!novoVooDia}" 
                                                                                styleClass="btn btn-success"
                                                                                reRender="workspacePanel,pageMessagesPanel"
                                                                                oncomplete="onTabChange();">
                                                                <apex:param name="dia" value="{!diaSelecionado}"/>
                                                            </apex:commandButton>
                                                        </apex:outputPanel>
                                                        <apex:commandButton value="Fechar" 
                                                                            action="{!fecharModal}" 
                                                                            styleClass="btn btn-outline-primary"
                                                                            reRender="modalPanel"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </apex:outputPanel>
                                    </apex:outputPanel>
                                    
                                    <!-- === SEÇÃO: RESUMO MENSAL === -->
                                    <apex:outputPanel id="manutencaoPanel">
                                        <apex:outputPanel rendered="{!AND(diasCalendario.size > 0, NOT(ISBLANK(filtroAeronaveIdCalendario)))}">
                                            <div class="secao-manutencoes">
                                                <!-- Resumo Mensal como Cabeçalho -->
                                                <div class="resumo-mensal">
                                                    <div class="resumo-header">
                                                        <h3>Resumo - {!nomeAeronaveAtual} - {!nomeMesAtual}</h3>
                                                        <button type="button"
                                                                class="btn btn-outline-primary flight-report-open"
                                                                title="Exportar relatório de horas">
                                                            <span class="report-export-icon" aria-hidden="true">↓</span>
                                                            Exportar
                                                        </button>
                                                    </div>
                                                    <div class="resumo-stats">
                                                        <div class="stat-item">
                                                            <div class="stat-numero">{!totalVoosMes}</div>
                                                            <div class="stat-label">Voos de {!nomeMesAtual}</div>
                                                        </div>
                                                        <div class="stat-item">
                                                            <div class="stat-numero">
                                                                <apex:outputText value="{0, number, #,##0.0}">
                                                                    <apex:param value="{!totalHorasMesCalendario}"/>
                                                                </apex:outputText>h
                                                            </div>
                                                            <div class="stat-label">Horas voadas de {!nomeMesAtual}</div>
                                                        </div>
                                                        <div class="stat-item">
                                                            <div class="stat-numero">
                                                                <apex:outputText value="{0, number, #,##0}">
                                                                    <apex:param value="{!totalCombustivelMes}"/>
                                                                </apex:outputText>L
                                                            </div>
                                                            <div class="stat-label">Combustível de {!nomeMesAtual}</div>
                                                        </div>
                                                        <div class="stat-item">
                                                            <div class="stat-numero">
                                                                R$ <apex:outputText value="{0, number, #,##0.00}">
                                                                <apex:param value="{!totalValorMesCalendario}"/>
                                                                </apex:outputText>
                                                            </div>
                                                            <div class="stat-label">Valor Total de {!nomeMesAtual}</div>
                                                        </div>
                                                        <div class="stat-item">
                                                            <div class="stat-numero">
                                                                <apex:outputText value="{0, number, #,##0.0}">
                                                                    <apex:param value="{!horasTotaisAeronaveAtual}"/>
                                                                </apex:outputText>
                                                            </div>
                                                            <div class="stat-label">Horas Totais da {!nomeAeronaveAtual}</div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                <!-- === SEÇÃO: INSPEÇÕES PRÓXIMAS === -->
                                                <apex:outputPanel rendered="{!AND(inspecoesProximasCalendario != null, inspecoesProximasCalendario.size > 0)}">
                                                    <div class="inspecoes-proximas-container">
                                                        <div class="inspecoes-proximas-header">
                                                            <h4>
                                                                Próximas Inspeções de {!nomeAeronaveAtual}
                                                            </h4>
                                                            <p class="subtitle">Inspeções mais próximas de vencer</p>
                                                        </div>
                                                        
                                                        <div class="inspecoes-proximas-grid" data-horas-totais="{!horasTotaisAeronaveAtual}">
                                                            <apex:repeat value="{!inspecoesProximasCalendario}" var="insp">
                                                                <div class="inspecao-card-mini status-{!insp.nivelStatus} {!IF(insp.status == 'VENCIDA', 'inspecao-vencida', '')}"
                                                                     data-horas-restantes="{!insp.horasRestantes}"
                                                                     data-dias-restantes="{!insp.diasRestantes}"
                                                                     data-status="{!insp.status}">
                                                                    
                                                                    <div class="inspecao-nome">
                                                                        Inspeção de: {!insp.registro.Nome_Inspecao__c}
                                                                    </div>
                                                                    
                                                                    <!-- Quando não tem horas nem data próxima - TBO VENCIDA -->
                                                                    <apex:outputPanel rendered="{!AND(insp.registro.Horas_Proxima__c == null, insp.registro.Data_Proxima__c == null, insp.status == 'VENCIDA')}">
                                                                        <div class="inspecao-status vencida">
                                                                            <span class="icon-alert">⚠️</span>
                                                                            VENCIDA
                                                                        </div>
                                                                        <div style="font-size: 11px; color: #721c24; margin-top: 8px; text-align: center;">
                                                                            Inspeção não realizada ou informações pendentes
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <!-- Próxima por Horas -->
                                                                    <apex:outputPanel rendered="{!insp.registro.Horas_Proxima__c != null}">
                                                                        <div class="inspecao-proxima">
                                                                            <span class="label">Próxima em</span>
                                                                            <span class="valor">
                                                                                <apex:outputText value="{0, number, #,##0.0}">
                                                                                    <apex:param value="{!insp.registro.Horas_Proxima__c}"/>
                                                                                </apex:outputText>h
                                                                            </span>
                                                                        </div>
                                                                        
                                                                        <div class="inspecao-restante horas-restantes-mini">
                                                                            <span class="label">Faltam</span>
                                                                            <span class="valor">
                                                                                <apex:outputText value="{0, number, #,##0.0}">
                                                                                    <apex:param value="{!insp.horasRestantes}"/>
                                                                                </apex:outputText> h
                                                                            </span>
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                    
                                                                    <!-- Próxima por Data -->
                                                                    <apex:outputPanel rendered="{!AND(insp.registro.Horas_Proxima__c == null, insp.registro.Data_Proxima__c != null)}">
                                                                        <div class="inspecao-proxima">
                                                                            <span class="label">Próxima em</span>
                                                                            <span class="valor">
                                                                                <apex:outputText value="{0, date, dd/MM/yyyy}">
                                                                                    <apex:param value="{!insp.registro.Data_Proxima__c}"/>
                                                                                </apex:outputText>
                                                                            </span>
                                                                        </div>
                                                                        
                                                                        <div class="inspecao-restante dias-restantes-mini">
                                                                            <span class="label">Faltam</span>
                                                                            <span class="valor">{!insp.diasRestantes} dias</span>
                                                                        </div>
                                                                    </apex:outputPanel>
                                                                    
                                                                </div>
                                                            </apex:repeat>
                                                        </div>
                                                    </div>
                                                </apex:outputPanel>
                                            </div>
                                        </apex:outputPanel>
                                    </apex:outputPanel>
                                    
                                </div>
                                
                                <!-- === ABA: NOVO VOO (antes: Novo Controle) === -->
                                <div id="panelNovo"
                                     class="tab-pane {!IF(abaAtiva == 'novo', 'active', '')}"
                                     role="tabpanel"
                                     aria-label="Novo registro"
                                     aria-hidden="{!IF(abaAtiva == 'novo', 'false', 'true')}">
                                    
                                    <!-- Introdução -->
                                    <div class="new-control-intro">
                                        <h3>{!tituloFormulario}</h3>
                                        <p>
                                            <apex:outputPanel rendered="{!modoEdicao}">
                                                Você está editando um registro existente. Faça as alterações necessárias e salve.
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!NOT(modoEdicao)}">
                                                Preencha os dados abaixo para registrar um novo controle de horas operacionais.
                                            </apex:outputPanel>
                                        </p>
                                    </div>
                                    
                                    <!-- Alerta de Modo de Edição -->
                                    <apex:outputPanel rendered="{!modoEdicao}">
                                        <div class="alert alert-info" style="background: #e3f2fd; border: 2px solid #2196f3; border-radius: 6px; padding: 14px; margin-bottom: 20px;">
                                            <strong>ℹ️ Modo de Edição:</strong> 
                                            Você está editando o voo de <strong><apex:outputText value="{0, date, dd/MM/yyyy}"><apex:param value="{!controleHoras.Data_do_Voo__c}"/></apex:outputText></strong>. 
                                            As alterações substituirão o registro original.
                                        </div>
                                    </apex:outputPanel>
                                    
                                    <!-- Seleção da Aeronave -->
                                    <div class="card">
                                        <div class="card-header">
                                            Seleção da Aeronave
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group">
                                                <label class="form-label">Aeronave</label>
                                                <apex:selectList value="{!aeronaveId}" size="1" styleClass="form-select">
                                                    <apex:selectOptions value="{!aeronaveOptions}"/>
                                                    <apex:actionSupport event="onchange" action="{!selecionarAeronave}" reRender="workspacePanel,pageMessagesPanel" status="loadingStatus" oncomplete="onTabChange();"/>
                                                </apex:selectList>
                                            </div>
                                            
                                            <!-- Toggle: Somente Abastecimento (Discreto) -->
                                            <apex:outputPanel rendered="{!camposHabilitados}">
                                                <div class="abastecimento-toggle-discreto">
                                                    <label for="checkboxAbastecimento">
                                                        <apex:inputCheckbox id="checkboxAbastecimento" value="{!somenteAbastecimento}" onclick="toggleModoAbastecimento(this.checked)"/>
                                                        <span class="abastecimento-icone-small">⛽</span>
                                                        Somente Abastecimento (sem voo)
                                                    </label>
                                                </div>
                                            </apex:outputPanel>
                                        </div>
                                    </div>
                                    
                                    <!-- Alerta quando modo abastecimento estiver ativo -->
                                    <div id="alertaAbastecimento" class="alert-abastecimento" style="display: none;">
                                        <span style="font-size: 16px;">ℹ️</span>
                                        <div>
                                            <strong>Modo Abastecimento:</strong> Campos de voo ocultados. Foco em combustível.
                                        </div>
                                    </div>
                                    
                                    <!-- Formulário de Controle de Horas de Voo -->
                                    <div class="card">
                                        <div class="card-header">
                                            Dados do Controle de Horas de Voo
                                        </div>
                                        <div class="card-body">
                                            
                                            <!-- Linha 1: Data do Voo (campo isolado) -->
                                            <div class="form-row">
                                                <div class="form-group single-field">
                                                    <label class="form-label">Data do Voo</label>
                                                    <apex:inputField value="{!controleHoras.Data_do_Voo__c}" 
                                                                     styleClass="form-control" 
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{0,date,dd/MM/yyyy}" 
                                                                     styleClass="form-control readonly-field readonly-display"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}">
                                                        <apex:param value="{!controleHoras.Data_do_Voo__c}"/>
                                                    </apex:outputText>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Linha 2: Piloto e Operador (na mesma linha) -->
                                            <div class="form-row">
                                                <div class="form-group half-width">
                                                    <label class="form-label required">Piloto <span style="color:#dc3545;">*</span></label>
                                                    <apex:selectList value="{!controleHoras.Piloto__c}" 
                                                                     size="1" 
                                                                     styleClass="form-select" 
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}">
                                                        <apex:selectOptions value="{!pilotoOptions}"/>
                                                    </apex:selectList>
                                                    <apex:outputPanel styleClass="form-control readonly-field readonly-display"
                                                                      rendered="{!AND(camposHabilitados, registroSalvo)}">
                                                                        <apex:outputText value="{!IF(ISBLANK(controleHoras.Piloto__r.Name), controleHoras.Piloto_Externo__c, controleHoras.Piloto__r.Name)}"/>
                                                                        <apex:outputPanel rendered="{!AND(ISBLANK(controleHoras.Piloto__r.Name), NOT(ISBLANK(controleHoras.Piloto_Externo__c)))}">
                                                                            <span class="badge-externo">externo</span>
                                                                        </apex:outputPanel>
                                                                    </apex:outputPanel>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                                <div class="form-group half-width">
                                                    <label class="form-label">Operador</label>
                                                    <apex:selectList value="{!controleHoras.Operador__c}" 
                                                                     size="1" 
                                                                     styleClass="form-select"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}">
                                                        <apex:selectOptions value="{!operadorOptions}"/>
                                                    </apex:selectList>
                                                    <apex:outputPanel styleClass="form-control readonly-field readonly-display"
                                                                      rendered="{!AND(camposHabilitados, registroSalvo)}">
                                                                        <apex:outputText value="{!IF(controleHoras.Operador__r.Name != null, controleHoras.Operador__r.Name, IF(ISBLANK(controleHoras.Operador_Externo__c), '-- Não informado --', controleHoras.Operador_Externo__c))}"/>
                                                                        <apex:outputPanel rendered="{!AND(ISBLANK(controleHoras.Operador__r.Name), NOT(ISBLANK(controleHoras.Operador_Externo__c)))}">
                                                                            <span class="badge-externo">externo</span>
                                                                        </apex:outputPanel>
                                                                    </apex:outputPanel>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Linha 5: Acionamento, Corte e TOT (na mesma linha) -->
                                            <div class="form-row">
                                                <div class="form-group third-width">
                                                    <label class="form-label">Acionamento</label>
                                                    <apex:inputField value="{!controleHoras.Acionamento__c}" 
                                                                     styleClass="form-control acionamento-field" 
                                                                     id="acionamento"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{!IF(controleHoras.Acionamento__c != null, TEXT(controleHoras.Acionamento__c), '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                                <div class="form-group third-width">
                                                    <label class="form-label">Corte</label>
                                                    <apex:inputField value="{!controleHoras.Corte__c}" 
                                                                     styleClass="form-control corte-field" 
                                                                     id="corte"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{!IF(controleHoras.Corte__c != null, TEXT(controleHoras.Corte__c), '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                                <div class="form-group third-width">
                                                    <label class="form-label">TOT (HH:MM)</label>
                                                    <!-- Campo visível para exibição no formato HH:MM (modo edição) -->
                                                    <apex:outputPanel rendered="{!AND(camposHabilitados, !registroSalvo)}">
                                                        <input type="text" 
                                                               class="form-control readonly-field tot-field-display" 
                                                               readonly="readonly" 
                                                               id="totDisplay" />
                                                    </apex:outputPanel>
                                                    <!-- Campo oculto com valor decimal para salvar -->
                                                    <apex:inputText value="{!totField}" 
                                                                    styleClass="tot-field" 
                                                                    style="display:none;"
                                                                    id="tot"
                                                                    rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <!-- Exibição do TOT quando registro está salvo -->
                                                    <apex:outputText value="{!totField}" 
                                                                     styleClass="form-control readonly-field readonly-display"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Linha 3: Horas de Voo e Tipo (na mesma linha) -->
                                            <div class="form-row">
                                                <div class="form-group half-width">
                                                    <label class="form-label">Horas de Voo(Decimal)</label>
                                                    <apex:inputText value="{!controleHoras.Horas_voo__c}" 
                                                                    styleClass="form-control readonly-field horasVoo-field"
                                                                    html-readonly="true" 
                                                                    id="horasVoo"
                                                                    rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{!controleHoras.Horas_voo__c}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                                <div class="form-group half-width">
                                                    <label class="form-label">Tipo</label>
                                                    <apex:selectList value="{!controleHoras.Tipo__c}" 
                                                                     size="1" 
                                                                     styleClass="form-select"
                                                                     id="tipo"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}">
                                                        <apex:selectOption itemValue="" itemLabel="-- Selecione --"/>
                                                        <apex:selectOption itemValue="TR" itemLabel="TR - Translado"/>
                                                        <apex:selectOption itemValue="SA" itemLabel="SA - Serviço Aéreo"/>
                                                        <apex:selectOption itemValue="PV" itemLabel="PV - Privado"/>
                                                        <apex:selectOption itemValue="EX" itemLabel="EX - Experimental"/>
                                                        <apex:selectOption itemValue="TT" itemLabel="TT - Tentativa"/>
                                                        <apex:selectOption itemValue="AB" itemLabel="AB - Abastecimento"/>
                                                    </apex:selectList>
                                                    <apex:outputText value="{!controleHoras.Tipo__c}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Linha 4: DEP (partida) e ARR (chegada) -->
                                            <div class="form-row">
                                                <div class="form-group half-width">
                                                    <label class="form-label">DEP (Partida)</label>
                                                    <apex:inputField value="{!controleHoras.DEP__c}" 
                                                                     styleClass="form-control"
                                                                     id="dep"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{!IF(controleHoras.DEP__c != null, controleHoras.DEP__c, '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                                <div class="form-group half-width">
                                                    <label class="form-label">ARR (Chegada)</label>
                                                    <apex:inputField value="{!controleHoras.ARR__c}" 
                                                                     styleClass="form-control"
                                                                     id="arr"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                    <apex:outputText value="{!IF(controleHoras.ARR__c != null, controleHoras.ARR__c, '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Linha 6: Observações -->
                                            <div class="form-row">
                                                <div class="form-group single-field">
                                                    <label class="form-label">Observações</label>
                                                    <apex:inputField value="{!controleHoras.Obs__c}" 
                                                                     styleClass="form-control"
                                                                     style="height: 70px; resize: vertical;"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}" html-placeholder="Informe aqui dados relevantes opcionais."/>
                                                    <apex:outputText value="{!IF(controleHoras.Obs__c != null, controleHoras.Obs__c, '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 70px;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <!-- Descrição -->
                                            <div class="form-row">
                                                <div class="form-group single-field">
                                                    <label class="form-label">Descrição</label>
                                                    <apex:inputField value="{!controleHoras.Descricao__c}" 
                                                                     styleClass="form-control"
                                                                     rendered="{!AND(camposHabilitados, !registroSalvo)}" html-placeholder="Informe aqui sobre projeto em que esta sendo realizado ou outras informações uteis."/>
                                                    <apex:outputText value="{!IF(controleHoras.Descricao__c != null, controleHoras.Descricao__c, '-- Não informado --')}" 
                                                                     styleClass="form-control readonly-field"
                                                                     style="display: block; padding: 8px 12px; border: 1px solid #ced4da; border-radius: 4px; background: #f8f9fa; min-height: 38px;"
                                                                     rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                    <apex:inputText value="{!mensagemCampoDesabilitado}" 
                                                                    styleClass="form-control disabled" 
                                                                    html-readonly="true"
                                                                    rendered="{!!camposHabilitados}"/>
                                                </div>
                                            </div>
                                            
                                            <div class="form-actions">
                                                <apex:outputText value="Preencha os dados acima e a Análise Técnica abaixo para salvar" 
                                                                 styleClass="text-info"
                                                                 style="font-weight: bold; color: #17a2b8;"
                                                                 rendered="{!AND(camposHabilitados, !registroSalvo)}"/>
                                                <apex:outputText value="Controle de horas e análise técnica finalizados com sucesso." 
                                                                 styleClass="text-success"
                                                                 style="font-weight: bold; color: #28a745;"
                                                                 rendered="{!AND(camposHabilitados, registroSalvo)}"/>
                                                <apex:outputText value="Selecione uma aeronave para começar" 
                                                                 styleClass="text-muted"
                                                                 rendered="{!!camposHabilitados}"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Card de Dados de Abastecimento -->
                                    <div id="cardAbastecimento" class="card">
                                        <div class="card-header">
                                            ⛽ Dados de Abastecimento
                                        </div>
                                        <div class="card-body">

                                            <!-- MODO EDIÇÃO: iterar sobre todos os abastecimentos vinculados -->
                                            <apex:outputPanel rendered="{!AND(modoEdicao, !registroSalvo)}">
                                                <apex:outputPanel rendered="{!abastecimentosEdicao.size == 0}">
                                                    <p style="color:#6c757d; font-style:italic; padding: 8px 0;">Nenhum abastecimento vinculado a este voo.</p>
                                                </apex:outputPanel>
                                                <apex:repeat value="{!abastecimentosEdicao}" var="ab">
                                                    <div class="fuel-calculation-row" style="border: 1px solid #dee2e6; border-radius: 6px; padding: 16px; margin-bottom: 16px;">
                                                        <div class="form-row">
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Quantidade (L)</label>
                                                                <apex:inputField value="{!ab.Quantidade__c}" 
                                                                                 styleClass="form-control fuel-quantity-field"
                                                                                 html-placeholder="Ex: 100"/>
                                                            </div>
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Custo Unitário (R$/L)</label>
                                                                <apex:inputField value="{!ab.Custo_Unitario__c}" 
                                                                                 styleClass="form-control fuel-unit-cost-field"
                                                                                 html-placeholder="Ex: 10,00 ou 10.00"/>
                                                            </div>
                                                        </div>
                                                        <div class="form-row">
                                                            <div class="form-group third-width">
                                                                <label class="form-label">Custo Total (R$)</label>
                                                                <apex:inputText value="{!ab.Custo_Total__c}"
                                                                                styleClass="form-control readonly-field fuel-total-cost-field"
                                                                                html-readonly="true"/>
                                                            </div>
                                                            <div class="form-group third-width">
                                                                <label class="form-label">Média (L/h)</label>
                                                                <apex:inputText styleClass="form-control readonly-field fuel-average-field"
                                                                                html-readonly="true"/>
                                                            </div>
                                                            <div class="form-group third-width">
                                                                <label class="form-label">Tipo Combustível</label>
                                                                <apex:inputField value="{!ab.Tipo_Combustivel__c}" 
                                                                                 styleClass="form-control"
                                                                                 html-placeholder="Ex: AVGAS, JET A, JET A-1, SAF"/>
                                                            </div>
                                                        </div>
                                                        <div class="form-row">
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Local</label>
                                                                <apex:inputField value="{!ab.Local__c}" 
                                                                                 styleClass="form-control"
                                                                                 html-placeholder="Ex: SNAX"/>
                                                            </div>
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Origem/Destino</label>
                                                                <apex:inputField value="{!ab.Origem_Destino__c}" 
                                                                                 styleClass="form-select"/>
                                                            </div>
                                                        </div>
                                                        <div class="form-row">
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Documento de Referência</label>
                                                                <apex:outputPanel rendered="{!NOT(ISBLANK(ab.Caminho_Anexo__c))}" layout="none">
                                                                    <a href="javascript:void(0)"
                                                                       class="anexo-nota-link"
                                                                       title="Baixar a nota anexada no PlaneIT"
                                                                       onclick="ControleHorasVooAnexo.baixar('{!JSENCODE(ab.Id)}', this);"><svg class="anexo-nota-icone" viewBox="0 0 520 520" aria-hidden="true" focusable="false"><path d="M176 367c6 6 15 5 21 0l100-100a20 20 0 0 1 28 0c9 8 8 22 0 30L202 418a70 70 0 0 1-99 0l-1-1a70 70 0 0 1 0-99l217-217a70 70 0 0 1 99 0l1 1a70 70 0 0 1 0 99l-1 1c-5 5-6 12-2 18a150 150 0 0 1 14 35c2 8 11 10 17 5l15-16a131 131 0 0 0 0-185h-2a131 131 0 0 0-185 0L58 275a131 131 0 0 0 0 185l2 2a130 130 0 0 0 184 0l124-123a81 81 0 1 0-117-113l-98 98c-6 6-6 16 0 22z"/></svg></a>
                                                                </apex:outputPanel>
                                                                <apex:inputTextarea value="{!ab.Documento_Referencia__c}" 
                                                                                    styleClass="form-control"
                                                                                    style="resize: vertical; min-height: 70px;"
                                                                                    html-placeholder="Ex: NF 12345"/>
                                                            </div>
                                                            <div class="form-group half-width">
                                                                <label class="form-label">Observações de Abastecimento</label>
                                                                <apex:inputField value="{!ab.Observacoes__c}" 
                                                                                 styleClass="form-control"
                                                                                 style="resize: vertical; min-height: 70px;"
                                                                                 html-placeholder="Campo opcional — preencha apenas se necessário"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </apex:repeat>
                                            </apex:outputPanel>

                                            <!-- PÓS-SAVE EM MODO EDIÇÃO: exibir todos os abastecimentos salvos (read-only) -->
                                            <apex:outputPanel rendered="{!AND(modoEdicao, registroSalvo)}">
                                                <apex:outputPanel rendered="{!abastecimentosEdicao.size == 0}">
