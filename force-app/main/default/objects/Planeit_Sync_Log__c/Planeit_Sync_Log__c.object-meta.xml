<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Registra cada tentativa automática de sincronização entre uma aeronave e o Planeit, incluindo período consultado, resultado, duração e contagens processadas.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <label>Log de Sincronização Planeit</label>
    <nameField>
        <displayFormat>PLN-{000000}</displayFormat>
        <label>Log de Sincronização Planeit</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Logs de Sincronização Planeit</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
